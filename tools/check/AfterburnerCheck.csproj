<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline checks of the KSP-free part of the mod (no KSP or Unity needed); usage in Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="AfterburnerCheck.cs" />
    <Compile Include="NozzleChecks.cs" />
    <Compile Include="..\..\Source\PlumeModel.cs" Link="Source\PlumeModel.cs" />
    <Compile Include="..\..\Source\NozzleLip.cs" Link="Source\NozzleLip.cs" />
    <Compile Include="..\..\Source\Atmosphere.cs" Link="Source\Atmosphere.cs" />
  </ItemGroup>
</Project>
