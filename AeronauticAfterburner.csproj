<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build: dotnet build -c Release [-p:KSPDir=<KSP install>]. Output: bin/Release/AeronauticAfterburner.dll -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>AeronauticAfterburner</AssemblyName>
    <RootNamespace>AeronauticAfterburner</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
    <Configurations>Release</Configurations>
    <DebugType>none</DebugType>
    <EnableSourceLink>false</EnableSourceLink>
    <KSPDir Condition="'$(KSPDir)' == ''">$(KSPDIR)</KSPDir>
    <Managed>$(KSPDir)\KSP_x64_Data\Managed</Managed>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <Target Name="ValidateKSPDir" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(Managed)\Assembly-CSharp.dll')" Text="Set KSPDir to your Kerbal Space Program installation." />
  </Target>
  <ItemGroup>
    <Compile Include="Source\AfterburnerPlumes.cs" />
    <Compile Include="Source\AfterburnerSettings.cs" />
    <Compile Include="Source\AssemblyInfo.cs" />
    <Compile Include="Source\Atmosphere.cs" />
    <Compile Include="Source\NozzleLip.cs" />
    <Compile Include="Source\PlumeDraw.cs" />
    <Compile Include="Source\PlumeModel.cs" />
    <Compile Include="Source\PlumeShaders.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(Managed)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(Managed)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Managed)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AssetBundleModule"><HintPath>$(Managed)\UnityEngine.AssetBundleModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ParticleSystemModule"><HintPath>$(Managed)\UnityEngine.ParticleSystemModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>$(Managed)\UnityEngine.AnimationModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(Managed)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(Managed)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
